{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-node",
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json"
  ]
}
