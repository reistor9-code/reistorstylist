{
  "name": "reistor-ai-stylist",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Reistor AI Stylist — WhatsApp Cloud API bot, runs on Cloudflare Workers or Node/Linode",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:page": "node scripts/build-page.mjs",
    "build:server": "npm run build:page && tsc -p tsconfig.server.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "pretest": "npm run build:server"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.1"
  }
}
