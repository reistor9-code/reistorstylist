{
  "name": "reistor-ai-stylist",
  "version": "0.1.0",
  "private": true,
  "description": "Reistor AI Stylist \u2014 WhatsApp Cloud API bot on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cards": "node tools/category-cards.mjs",
    "build:node": "tsc -p tsconfig.node.json",
    "start": "node dist-node/server.js",
    "cron": "node dist-node/cron.js",
    "dev:node": "tsx watch src/server.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.1"
  },
  "dependencies": {
    "redis": "^6.2.1"
  }
}
