{
  "name": "reistor-ai-stylist",
  "version": "0.1.0",
  "private": true,
  "description": "Reistor AI Stylist \u2014 WhatsApp Cloud API bot on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dashboard:preview": "esbuild tools/preview-dashboard.ts --bundle --platform=node --format=esm --loader:.json=json --outfile=node_modules/.cache/preview.mjs --log-level=error && node node_modules/.cache/preview.mjs > web/dashboard.preview.html"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.1"
  }
}
