{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Both runtimes, because the project has two entrypoints: src/index.ts for
    // Cloudflare and src/server.ts for Node. The globals do not collide, and
    // omitting "node" makes `Buffer` and `node:http` fail to resolve in the
    // server adapter while every other file typechecks fine.
    "types": ["@cloudflare/workers-types", "node"],
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.json"]
}
