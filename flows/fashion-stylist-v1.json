{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "occasion_select": ["category_select"],
    "category_select": ["product_grid"],
    "product_grid": ["checkout"],
    "checkout": []
  },
  "screens": [
    {
      "id": "occasion_select",
      "title": "What are we styling you for?",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "occasion_nav",
            "list-items": [
              {
                "id": "work",
                "main-content": {
                  "title": "Work",
                  "description": "Tailored hemp and linen shirting"
                },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Work looks"
                },
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "category_select" },
                  "payload": { "occasion": "work" }
                }
              },
              {
                "id": "vacation",
                "main-content": {
                  "title": "Vacation",
                  "description": "Breathable modal and Tencel that pack flat"
                },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Vacation looks"
                },
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "category_select" },
                  "payload": { "occasion": "vacation" }
                }
              },
              {
                "id": "brunch",
                "main-content": {
                  "title": "Casual Brunch",
                  "description": "Relaxed shapes for slow weekend plans"
                },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Brunch looks"
                },
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "category_select" },
                  "payload": { "occasion": "brunch" }
                }
              },
              {
                "id": "gym",
                "main-content": {
                  "title": "Gym / Active",
                  "description": "Modal and cotton cut to move"
                },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Active looks"
                },
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "category_select" },
                  "payload": { "occasion": "gym" }
                }
              },
              {
                "id": "date",
                "main-content": {
                  "title": "Date Night",
                  "description": "Bias-cut Tencel and linen with a quiet shine"
                },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Date night looks"
                },
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "category_select" },
                  "payload": { "occasion": "date" }
                }
              },
              {
                "id": "festive",
                "main-content": {
                  "title": "Festive",
                  "description": "Occasion dressing in natural fabrics"
                },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Festive looks"
                },
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "category_select" },
                  "payload": { "occasion": "festive" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "category_select",
      "title": "What should we shop?",
      "terminal": false,
      "data": {
        "occasion": { "type": "string", "__example__": "work" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "category_nav",
            "list-items": [
              {
                "id": "tops",
                "main-content": { "title": "Tops", "description": "Shirts, blouses and tees" },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Tops"
                },
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "occasion": "${data.occasion}", "category": "tops" }
                }
              },
              {
                "id": "bottoms",
                "main-content": { "title": "Bottoms", "description": "Trousers, shorts and skirts" },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Bottoms"
                },
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "occasion": "${data.occasion}", "category": "bottoms" }
                }
              },
              {
                "id": "coords",
                "main-content": { "title": "Co-ords", "description": "Matched tops and bottoms" },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Co-ords"
                },
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "occasion": "${data.occasion}", "category": "coords" }
                }
              },
              {
                "id": "dresses",
                "main-content": { "title": "Dresses", "description": "Midi, slip and shirt dresses" },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Dresses"
                },
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "occasion": "${data.occasion}", "category": "dresses" }
                }
              },
              {
                "id": "outerwear",
                "main-content": { "title": "Outerwear", "description": "Unlined hemp layers" },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Outerwear"
                },
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "occasion": "${data.occasion}", "category": "outerwear" }
                }
              },
              {
                "id": "accessories",
                "main-content": { "title": "Accessories", "description": "Belts, scarves and bags" },
                "start": {
                  "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                  "alt-text": "Accessories"
                },
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "occasion": "${data.occasion}", "category": "accessories" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "product_grid",
      "title": "Your picks",
      "terminal": false,
      "data": {
        "occasion": { "type": "string", "__example__": "work" },
        "category": { "type": "string", "__example__": "tops" },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "main-content": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "metadata": { "type": "string" }
                }
              },
              "start": {
                "type": "object",
                "properties": {
                  "image": { "type": "string" },
                  "alt-text": { "type": "string" }
                }
              },
              "on-click-action": { "type": "object" }
            }
          },
          "__example__": [
            {
              "id": "hemp-poplin-shirt",
              "main-content": {
                "title": "Hemp Poplin Shirt",
                "description": "Hemp, relaxed placket",
                "metadata": "Rs 2,499"
              },
              "start": {
                "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                "alt-text": "Hemp Poplin Shirt"
              },
              "on-click-action": {
                "name": "navigate",
                "next": { "type": "screen", "name": "checkout" },
                "payload": { "product_id": "hemp-poplin-shirt" }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "product_nav",
            "list-items": "${data.products}"
          }
        ]
      }
    },
    {
      "id": "checkout",
      "title": "Delivery details",
      "terminal": true,
      "success": true,
      "data": {
        "product_id": { "type": "string", "__example__": "hemp-poplin-shirt" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "delivery_form",
            "children": [
              {
                "type": "TextInput",
                "name": "full_name",
                "label": "Full name",
                "input-type": "text",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "phone",
                "label": "Phone",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "TextArea",
                "name": "address",
                "label": "Address",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "pincode",
                "label": "Pincode",
                "input-type": "number",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Continue to payment",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "product_id": "${data.product_id}",
                    "full_name": "${form.full_name}",
                    "phone": "${form.phone}",
                    "address": "${form.address}",
                    "pincode": "${form.pincode}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
