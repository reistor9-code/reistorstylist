# Copy to `.env` on the server (or to `.dev.vars` for `wrangler dev`).
# Never commit the real file — it is in .gitignore for a reason.
#
#   chmod 600 .env
#
# On Cloudflare these same values are set with `wrangler secret put <NAME>`.

# --- WhatsApp / Meta ---------------------------------------------------------

# System User token with whatsapp_business_messaging + whatsapp_business_management.
# The temporary token in API Setup expires after 24 hours; do not ship with it.
WHATSAPP_TOKEN="EAA..."

# The phone number ID, not the phone number.
PHONE_NUMBER_ID="123456789012345"

# Any string you choose. Must match exactly what you paste into Meta's webhook
# config. Also gates the /admin/* routes.
VERIFY_TOKEN="reistor-stylist-verify"

# Meta App Secret — App Dashboard -> Settings -> Basic -> App Secret.
#
# REQUIRED before a production number. Without it the webhook accepts forged
# payloads from anyone who finds the URL, and `from` is attacker-controlled, so
# they can make this bot send WhatsApp messages to any number on your bill.
APP_SECRET=""

# WhatsApp Business Account ID. Needed by the nightly pull to read template
# performance. Not sensitive.
WABA_ID=""

GRAPH_API_VERSION="v25.0"
TEMPLATE_LANGUAGE="en_US"

# Meta Commerce catalog connected to the WABA. Unset it and recommended looks
# fall back to plain images with no product page behind them.
CATALOG_ID="1572339217700903"
OCCASION_TEMPLATE="occasion_picker"
CATEGORY_TEMPLATE="category_picker"

# --- Supabase ----------------------------------------------------------------

# Both are required for analytics AND for portable state. With them set, the
# bot stores conversation state in Postgres instead of Cloudflare KV — which is
# what lets this identical code run on a Linode box.
SUPABASE_URL="https://<project>.supabase.co"

# Service role key. Bypasses row level security, so it belongs on the server
# and never in a browser bundle.
SUPABASE_SERVICE_KEY=""

# --- Dashboard ---------------------------------------------------------------

# Shared secret for /dashboard. Generate one: openssl rand -hex 32
# Unset means the route refuses every request.
DASHBOARD_TOKEN=""

# --- Anthropic ---------------------------------------------------------------

# Optional. Without it the stylist replies with fixed copy; ranking is
# deterministic either way and never calls a model.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Shopify (India store) ---------------------------------------------------

IND_SHOPIFY_STORE="reistor-life.myshopify.com"
IND_SHOPIFY_STORE_ID="gid://shopify/Shop/52246577337"
IND_SHOPIFY_API_VERSION="2026-04"
IND_SHOPIFY_API_KEY=""
# Only shpat_ / shpca_ prefixes authenticate. shpss_ is the app secret key and
# yields "Invalid API key or access token".
IND_SHOPIFY_API_SECRET=""

# --- Server (Linode only; ignored on Cloudflare) ------------------------------

PORT="8787"

# The public origin, used to build absolute URLs. nginx terminates TLS, so this
# is the https hostname, not the loopback address the process binds to.
PUBLIC_BASE_URL="https://stylist.reistor.in"

# Hour (UTC) for the nightly analytics pull. 21 = 02:30 IST.
PULL_UTC_HOUR="21"
